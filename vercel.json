{
  "crons": [
    {
      "path": "/api/email/monthly-newsletter",
      "schedule": "0 0 1 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/newsletter/subscribe",
      "destination": "/api/newsletter?action=subscribe"
    },
    {
      "source": "/api/newsletter/unsubscribe",
      "destination": "/api/newsletter?action=unsubscribe"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog-share?slug=:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

