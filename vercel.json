{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "casa-loy-tequilera.vercel.app"
        }
      ],
      "destination": "https://casaloy.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.casaloy.com"
        }
      ],
      "destination": "https://casaloy.com/:path*",
      "permanent": true
    },
    {
      "source": "/maquilas",
      "destination": "/marca-propia",
      "permanent": true
    },
    {
      "source": "/bottling",
      "destination": "/private-label",
      "permanent": true
    },
    {
      "source": "/maquilas-v2",
      "destination": "/marca-propia",
      "permanent": true
    },
    {
      "source": "/bottling-v2",
      "destination": "/private-label",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/email/monthly-newsletter",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/email/maquila-followup",
      "schedule": "0 15 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/email/welcome",
      "destination": "/api/email?action=welcome"
    },
    {
      "source": "/api/email/monthly-newsletter",
      "destination": "/api/email?action=monthly-newsletter"
    },
    {
      "source": "/api/email/maquila-followup",
      "destination": "/api/email?action=maquila-followup"
    },
    {
      "source": "/api/newsletter/subscribe",
      "destination": "/api/newsletter?action=subscribe"
    },
    {
      "source": "/api/newsletter/unsubscribe",
      "destination": "/api/newsletter?action=unsubscribe"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog-share?slug=:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

